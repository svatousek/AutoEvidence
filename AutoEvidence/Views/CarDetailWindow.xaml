<Window x:Class="AutoEvidence.Views.CarDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detaily vozu" Width="900" Height="560" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="#FFF7F8FA" FontFamily="Segoe UI">
    <!--
      Pseudokód / plán (krok za krokem):
      1) Vytvořit moderní, přehledné okno s vizuálním rozdělením: obrázek vlevo, hlavní informace uprostřed, rychlé statistiky + akce vpravo.
      2) Data plynou z DataContextu (třída CarViewModel) s vlastnostmi:
         - ImagePath (string / ImageSource)
         - Make, Model, Year, VIN, LicensePlate
         - ColorName (string), ColorBrush (Brush)
         - Mileage (int), Engine (string), FuelType, Transmission
         - OwnerName, Status, Notes, InsuranceExpiry, NextServiceDate
      3) V levém panelu: obrázek vozu v rámečku, pod ním malé info (SPZ, rok).
      4) V hlavním panelu: velký název (Make + Model), pod ním hlavní detaily jako seznam label:value.
      5) Zobrazit barvu jako barevný čtverec a hex/název barvy.
      6) V pravém panelu: klíčové statistiky (nájezd, stav, palivo) v kartách a tlačítka (Upravit, Zavřít).
      7) Přidat rozbalitelnou sekci "Další informace" pro méně důležité položky (pojištění, servis, poznámky).
      8) Vše pomocí čistých stylů a vazeb; očekává se, že ViewModel dodá již připravené hodnoty (např. ColorBrush).
    -->

    <Window.Resources>
        <!-- Jednoduché styly pro konzistentní vzhled -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FF111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22000000"
                              BlurRadius="8"
                              ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Obrázek a základní info -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Border Height="180" CornerRadius="6" Background="#FFF0F2F5" VerticalAlignment="Top" Margin="0,0,0,10" >
                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill" ClipToBounds="True"/>
                </Border>

                <TextBlock Text="{Binding Make}" FontSize="18" FontWeight="Bold" Foreground="#FF0F172A"/>
                <TextBlock Text="{Binding Model}" FontSize="14" Foreground="#FF475569" Margin="0,2,0,10"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                    <StackPanel Width="120">
                        <TextBlock Text="Rok výroby" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Year}" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="SPZ" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding LicensePlate}" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </StackPanel>

                <Separator Margin="0,12,0,12"/>

                <TextBlock Text="Barva" Style="{StaticResource LabelStyle}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="4" Background="{Binding ColorBrush}" BorderBrush="#22000000" BorderThickness="1" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding ColorName}" Style="{StaticResource ValueStyle}"/>
                        <TextBlock Text="{Binding ColorHex}" FontSize="12" Foreground="#FF6B7280"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CENTER: Hlavní informace -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding FullName}" FontSize="20" FontWeight="Bold" Foreground="#FF0F172A"/>
                        <TextBlock Text="{Binding VIN}" FontSize="12" Foreground="#FF6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#FF10B981" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Najeto" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Mileage, StringFormat={}{0:N0} km}" Style="{StaticResource ValueStyle}"/>

                        <TextBlock Text="Motor" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding Engine}" Style="{StaticResource ValueStyle}"/>

                        <TextBlock Text="Převodovka" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding Transmission}" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="Palivo" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding FuelType}" Style="{StaticResource ValueStyle}"/>

                        <TextBlock Text="Vlastník" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding OwnerName}" Style="{StaticResource ValueStyle}"/>

                        <TextBlock Text="VIN" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding VIN}" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </Grid>

                <Expander Header="Další informace" Margin="0,16,0,0" IsExpanded="False">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Pojištění do" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding InsuranceExpiry, StringFormat={}{0:dd.MM.yyyy}}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="Další servis" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding NextServiceDate, StringFormat={}{0:dd.MM.yyyy}}" Style="{StaticResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock Text="Poznámky" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="#FF374151"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- RIGHT: Rychlé karty + akce -->
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Rychlé statistiky" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Rows="3" Margin="0,4,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <Border Background="#FFF8FAFC" CornerRadius="6" Padding="8" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Najeto" FontSize="11" Foreground="#FF6B7280"/>
                                <TextBlock Text="{Binding Mileage, StringFormat={}{0:N0} km}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF8FAFC" CornerRadius="6" Padding="8" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Palivo" FontSize="11" Foreground="#FF6B7280"/>
                                <TextBlock Text="{Binding FuelType}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF8FAFC" CornerRadius="6" Padding="8" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Stav" FontSize="11" Foreground="#FF6B7280"/>
                                <TextBlock Text="{Binding Status}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF8FAFC" CornerRadius="6" Padding="8" Margin="4">
                            <StackPanel>
                                <TextBlock Text="VIN (krátké)" FontSize="11" Foreground="#FF6B7280"/>
                                <TextBlock Text="{Binding VINShort}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF8FAFC" CornerRadius="6" Padding="8" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Poslední servis" FontSize="11" Foreground="#FF6B7280"/>
                                <TextBlock Text="{Binding LastService, StringFormat={}{0:dd.MM.yyyy}}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF8FAFC" CornerRadius="6" Padding="8" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Dostupnost" FontSize="11" Foreground="#FF6B7280"/>
                                <TextBlock Text="{Binding AvailabilityText}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Akce" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Button Content="Upravit" Height="36" Margin="0,4,0,4" Command="{Binding EditCommand}" Background="#FF2563EB" Foreground="White"/>
                    <Button Content="Zavřít" Height="36" Margin="0,4,0,4" Click="Close_Click"/>
                    <Button Content="Vytvořit protokol" Height="36" Margin="0,12,0,0" Command="{Binding CreateReportCommand}" Background="#FF10B981" Foreground="White"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>